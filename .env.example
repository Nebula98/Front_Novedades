# ═══════════════════════════════════════════════════════════════════════════
# Environment Configuration for Front_Novedades
# ═══════════════════════════════════════════════════════════════════════════
# 
# Este archivo debe copiarse a .env y configurarse con los valores específicos
# del entorno de desarrollo/producción.
# 
# IMPORTANTE: El archivo .env nunca debe ser commiteado al repositorio.
# Usa .env.local para cambios locales no versionados.

# ─── API Configuration ───────────────────────────────────────────────────────
# URL base del servidor API (sin barras finales)
VITE_API_BASE_URL=http://localhost:3000/api

# ─── Application Configuration ──────────────────────────────────────────────
# Cambiar estos valores según el entorno (development/production)
VITE_APP_NAME=Front_Novedades
VITE_APP_VERSION=1.0.0

# ─── Optional: Analytics/Monitoring ─────────────────────────────────────────
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# VITE_ANALYTICS_ID=your-analytics-id
